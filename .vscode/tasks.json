{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto Snapshot",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "C:\\src\\Development\\autosnapshot.ps1"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Auto Backup Watcher",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "taskkill /f /fi \"windowtitle eq Flutter Auto-Watcher Backup*\" 2>nul & C:\\src\\Development\\auto_watch_backup.bat"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}